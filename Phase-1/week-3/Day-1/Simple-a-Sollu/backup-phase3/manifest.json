{
  "manifest_version": 3,
  "name": "Simple-ah Sollu",
  "version": "0.3.0",
  "description": "Select any confusing text, right-click, and get a simple explanation. Simple-ah sollu! 💬",

  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.groq.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "action": {
    "default_title": "Simple-ah Sollu 💬",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
